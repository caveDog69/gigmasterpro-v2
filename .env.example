# REST API base URL. Defaults to "<base path>api" (same host as the frontend).
VITE_API_BASE_URL=
# Sub-folder the app is served from, e.g. /dev/ for the preview deploy. Defaults to /.
VITE_BASE_PATH=/
# Public site URL used for canonical/Open Graph tags and sitemap.xml (no trailing slash).
VITE_SITE_URL=https://gigmasterpro.com
# Local dev only: where `vite` proxies /api and /uploads (php -S 127.0.0.1:8080 dev-router.php).
VITE_DEV_API_PROXY=http://127.0.0.1:8080
